NODE_ENV=production
PORT=3000
TRUST_PROXY=true
CORS_ORIGINS=*

# PostgreSQL (externe ou docker-compose.prod.yml)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Optionnel : si vous fournissez une URL directe non-pooler, elle est utilisee en priorite.
# Sinon, lorsque DATABASE_URL contient "-pooler." (ex: Neon), l'URL directe est derivee automatiquement.
PRISMA_MIGRATE_DATABASE_URL=
# Alias accepte si votre hebergeur fournit deja DIRECT_URL.
DIRECT_URL=
POSTGRES_USER=jokko
POSTGRES_PASSWORD=generate-a-strong-postgres-password
POSTGRES_DB=jokko

JWT_ACCESS_SECRET=generate-a-strong-random-secret-min-32-chars
JWT_REFRESH_SECRET=generate-a-strong-random-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GOOGLE_CLIENT_ID=
# Cle serveur: Geocoding/Routes uniquement, ne doit pas etre exposee au navigateur.
GOOGLE_MAPS_API_KEY=
# Cle navigateur: obligatoire en production pour afficher la carte Google Maps dans Angular.
# A restreindre aux domaines autorises et aux API Maps JavaScript/Places.
GOOGLE_MAPS_BROWSER_API_KEY=
# Map ID Google Cloud pour Advanced Markers. Laisser vide utilise le repli demo en local seulement.
GOOGLE_MAPS_MAP_ID=

THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=100
THROTTLE_MEDIUM_TTL=60000
THROTTLE_MEDIUM_LIMIT=1200
THROTTLE_LONG_TTL=600000
THROTTLE_LONG_LIMIT=10000

RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@jokko.app
EMAIL_FROM_NAME=Jokko

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

PAYMENT_GATEWAY_MODE=external
PAYMENT_WEBHOOK_SECRET=generate-a-strong-payment-webhook-secret
WAVE_API_BASE_URL=
WAVE_API_KEY=
ORANGE_MONEY_API_BASE_URL=
ORANGE_MONEY_API_KEY=
CARD_PAYMENT_API_BASE_URL=
CARD_PAYMENT_API_KEY=

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate-a-strong-redis-password
REDIS_LOG_LEVEL=notice

FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

AWS_S3_BUCKET=jokko-uploads
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SENTRY_DSN=
