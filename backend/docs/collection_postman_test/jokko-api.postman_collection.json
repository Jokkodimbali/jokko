{
  "info": {
    "name": "Jokko API",
    "description": "API Jokko - Endpoints pour tests Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "default"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "default"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "default"
    },
    {
      "key": "userId",
      "value": "",
      "type": "default"
    },
    {
      "key": "professionalId",
      "value": "",
      "type": "default"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Variable pour stocker les tokens",
          "if (!pm.environment.has('accessToken')) {",
          "  pm.environment.set('accessToken', '');",
          "}",
          "if (!pm.environment.has('refreshToken')) {",
          "  pm.environment.set('refreshToken', '');",
          "}",
          "if (!pm.environment.has('userId')) {",
          "  pm.environment.set('userId', '');",
          "}",
          "if (!pm.environment.has('professionalId')) {",
          "  pm.environment.set('professionalId', '');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Santé",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/sante",
              "host": ["{{baseUrl}}"],
              "path": ["sante"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "send"]
            },
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+221770000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "verify"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+221770000000\",\n  \"code\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+221770000001\",\n  \"name\": \"Moussa Diallo\",\n  \"email\": \"moussa@example.com\",\n  \"password\": \"MonMotDePasse123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+221770000001\",\n  \"password\": \"MonMotDePasse123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/google/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"YOUR_GOOGLE_ID_TOKEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
