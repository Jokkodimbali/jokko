        {
          "name": "Get My History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/me/history?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete My Account",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Professionals",
