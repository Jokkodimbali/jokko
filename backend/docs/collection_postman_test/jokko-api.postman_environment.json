{
  "id": "jokko-api-env",
  "name": "Jokko API Environment",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "userId",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "professionalId",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "serviceId",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "itemId",
      "value": "",
      "type": "default",
      "enabled": true
    },
    {
      "key": "availabilityId",
      "value": "",
      "type": "default",
      "enabled": true
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatic token storage after login or register",
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "  var jsonData = pm.response.json();",
          "  if (jsonData.data && jsonData.data.accessToken) {",
          "    pm.environment.set('accessToken', jsonData.data.accessToken);",
          "  }",
          "  if (jsonData.data && jsonData.data.refreshToken) {",
          "    pm.environment.set('refreshToken', jsonData.data.refreshToken);",
          "  }",
          "  if (jsonData.data && jsonData.data.user && jsonData.data.user.id) {",
          "    pm.environment.set('userId', jsonData.data.user.id);",
          "  }",
          "  if (jsonData.data && jsonData.data.id) {",
          "    pm.environment.set('userId', jsonData.data.id);",
          "  }",
          "  if (jsonData.data && jsonData.data.professional && jsonData.data.professional.id) {",
          "    pm.environment.set('professionalId', jsonData.data.professional.id);",
          "  }",
          "}",
          "",
          "// Clear tokens on logout",
          "if (pm.request.method === 'POST' && pm.request.url && pm.request.url.indexOf('/auth/logout') !== -1) {",
          "  pm.environment.set('accessToken', '');",
          "  pm.environment.set('refreshToken', '');",
          "}",
          "",
          "// Store IDs for dynamic routes",
          "if (pm.request.method === 'POST' && pm.request.url && pm.request.url.indexOf('/professionals/profile') !== -1) {",
          "  var jsonData = pm.response.json();",
          "  if (jsonData.data && jsonData.data.id) {",
          "    pm.environment.set('professionalId', jsonData.data.id);",
          "  }",
          "}",
          "if (pm.request.method === 'POST' && pm.request.url && pm.request.url.indexOf('/professionals/me/services') !== -1) {",
          "  var jsonData = pm.response.json();",
          "  if (jsonData.data && jsonData.data.id) {",
          "    pm.environment.set('serviceId', jsonData.data.id);",
          "  }",
          "}",
          "if (pm.request.method === 'POST' && pm.request.url && pm.request.url.indexOf('/professionals/me/portfolio') !== -1) {",
          "  var jsonData = pm.response.json();",
          "  if (jsonData.data && jsonData.data.id) {",
          "    pm.environment.set('itemId', jsonData.data.id);",
          "  }",
          "}",
          "if (pm.request.method === 'POST' && pm.request.url && pm.request.url.indexOf('/professionals/me/availabilities') !== -1) {",
          "  var jsonData = pm.response.json();",
          "  if (jsonData.data && jsonData.data.id) {",
          "    pm.environment.set('availabilityId', jsonData.data.id);",
          "  }",
          "}"
        ]
      }
    }
  ]
}