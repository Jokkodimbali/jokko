generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis()]
}

enum RoleUtilisateur {
  CLIENT
  PRESTATAIRE
  ADMIN
}

enum StatutKyc {
  EN_ATTENTE
  VERIFIE
  REJETE
}

enum TypePrix {
  FIXE
  NEGOCIABLE
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  PAYEE_SEQUESTRE
  EN_COURS
  TERMINEE
  ANNULEE
  NO_SHOW
  LITIGE
}

enum MethodePaiement {
  WAVE
  ORANGE_MONEY
  CARTE
}

enum StatutPaiement {
  EN_ATTENTE
  SUCCES
  ECHEC
  REMBOURSE
}

enum StatutRetrait {
  EN_ATTENTE
  EN_COURS
  TERMINE
  ECHEC
  ANNULE
}

enum StatutIdempotence {
  EN_COURS
  TERMINE
  ECHEC
}

enum StatutWebhookPaiement {
  RECU
  TRAITE
  ECHEC
  IGNORE
}

enum TypeTransactionPortefeuille {
  CREDIT_ESCROW
  DEBIT_RETRAIT
  REMBOURSEMENT
  COMMISSION
  AJUSTEMENT
}

enum EscrowStatus {
  LOCKED
  RELEASED
  DISPUTED
  REFUNDED
}

enum TypeNotification {
  NOUVELLE_RESERVATION
  RESERVATION_CONFIRMEE
  RESERVATION_ANNULEE
  PRESTATAIRE_EN_ROUTE
  PAIEMENT_LIBERE
  NOUVEAU_MESSAGE
  KYC_APPROUVEE
  KYC_REJETEE
  LITIGE_RESOLU
}

enum CanalCommunication {
  EMAIL
  SMS
}

enum StatutCommunication {
  EN_ATTENTE
  ENVOYE
  ECHEC
  CONFIGURATION_MANQUANTE
}

model Utilisateur {
  id                String            @id @default(uuid()) @db.Uuid
  numeroTelephone   String            @unique @map("phone_number") @db.VarChar(20)
  nom               String            @map("name") @db.VarChar(100)
  email             String?           @unique @db.VarChar(150)
  adresse           String?           @map("address") @db.VarChar(255)
  motDePasseHash    String?           @map("password_hash") @db.VarChar(255)
  fournisseurOauth  String?           @map("oauth_provider") @db.VarChar(50)
  identifiantOauth  String?           @map("oauth_id") @db.VarChar(200)
  role              RoleUtilisateur   @default(CLIENT)
  urlAvatar         String?           @map("avatar_url") @db.VarChar(500)
  jetonFcm          String?           @map("fcm_token") @db.VarChar(500)
  estActif          Boolean           @default(true) @map("is_active")
  creeLe            DateTime          @default(now()) @map("created_at")
  misAJourLe        DateTime          @updatedAt @map("updated_at")

  profilProfessionnel       ProfilProfessionnel?
  reservationsClient        Reservation[]          @relation("ReservationsClient")
  conversationsClient       Conversation[]         @relation("ConversationsClient")
  conversationsPrestataire  Conversation[]         @relation("ConversationsPrestataire")
  messagesEnvoyes           Message[]              @relation("MessagesEnvoyes")
  notifications             Notification[]
  communicationsReservation CommunicationReservation[]
  sessionsAuthentification  SessionAuthentification[]

  @@map("users")
}

model SessionAuthentification {
  id             String      @id @default(uuid()) @db.Uuid
  utilisateurId  String      @map("user_id") @db.Uuid
  hashJeton      String      @map("token_hash") @db.VarChar(255)
  expireLe       DateTime    @map("expires_at")
  revoqueLe      DateTime?   @map("revoked_at")
  creeLe         DateTime    @default(now()) @map("created_at")
  misAJourLe     DateTime    @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([hashJeton])
  @@index([utilisateurId])
  @@index([expireLe])
  @@map("auth_sessions")
}

model VerificationOtp {
  id                String    @id @default(uuid()) @db.Uuid
  numeroTelephone   String    @unique @map("phone_number") @db.VarChar(20)
  hashCode          String    @map("code_hash") @db.VarChar(255)
  expireLe          DateTime  @map("expires_at")
  tentatives        Int       @default(0) @map("attempts")
  dernierEnvoiLe    DateTime  @map("last_sent_at")
  consommeLe        DateTime? @map("consumed_at")
  creeLe            DateTime  @default(now()) @map("created_at")
  misAJourLe        DateTime  @updatedAt @map("updated_at")

  @@index([expireLe])
  @@map("otp_verifications")
}

model ProfilProfessionnel {
  id                 String       @id @default(uuid()) @db.Uuid
  utilisateurId      String       @unique @map("user_id") @db.Uuid
  biographie         String?      @map("bio") @db.Text
  nomEntreprise      String?      @map("company_name") @db.VarChar(150)
  urlPieceIdentiteRecto   String?      @map("id_card_url_recto") @db.VarChar(500)
  urlPieceIdentiteVerso  String?      @map("id_card_url_verso") @db.VarChar(500)
  statutKyc          StatutKyc    @default(EN_ATTENTE) @map("kyc_status")
  raisonRejetKyc     String?      @map("kyc_reject_reason") @db.Text
  localisation       Unsupported("geography(Point, 4326)")?
  ville              String?      @map("city") @db.VarChar(100)
  noteGlobale        Decimal      @default(0.0) @map("global_rating") @db.Decimal(2, 1)
  nombreAvis         Int          @default(0) @map("total_reviews")
  soldePortefeuille  Decimal      @default(0.00) @map("wallet_balance") @db.Decimal(12, 2)
  creeLe             DateTime     @default(now()) @map("created_at")

  utilisateur      Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  services         Service[]
  disponibilites   Disponibilite[]
  elementsPortfolio ElementPortfolio[]
  reservations     Reservation[]
  demandesRetrait  DemandeRetrait[]
  transactionsPortefeuille TransactionPortefeuille[]

  @@map("professional_profiles")
}

model Categorie {
  id         String     @id @default(uuid()) @db.Uuid
  nom        String     @map("name") @unique @db.VarChar(100)
  urlIcone   String?    @map("icon_url") @db.VarChar(500)
  ordreTri   Int        @default(0) @map("sort_order") @db.SmallInt
  estActive  Boolean    @default(true) @map("is_active")

  services   Service[]

  @@map("categories")
}

model Service {
  id                    String              @id @default(uuid()) @db.Uuid
  profilProfessionnelId String              @map("professional_id") @db.Uuid
  categorieId           String              @map("category_id") @db.Uuid
  nom                   String              @map("name") @db.VarChar(200)
  description           String              @db.Text
  prix                  Decimal             @map("price") @db.Decimal(10, 2)
  typePrix              TypePrix            @map("price_type")
  estDisponible         Boolean             @default(true) @map("is_available")
  creeLe                DateTime            @default(now()) @map("created_at")
  misAJourLe            DateTime            @updatedAt @map("updated_at")

  profilProfessionnel   ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id], onDelete: Cascade)
  categorie             Categorie           @relation(fields: [categorieId], references: [id])
  reservations          Reservation[]

  @@map("services")
}

model Disponibilite {
  id                    String              @id @default(uuid()) @db.Uuid
  profilProfessionnelId String              @map("professional_id") @db.Uuid
  jourSemaine           Int                 @map("day_of_week") @db.SmallInt
  heureDebut            DateTime            @map("start_time") @db.Time
  heureFin              DateTime            @map("end_time") @db.Time
  estActive             Boolean             @default(true) @map("is_active")

  profilProfessionnel   ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model ElementPortfolio {
  id                    String              @id @default(uuid()) @db.Uuid
  profilProfessionnelId String              @map("professional_id") @db.Uuid
  titre                 String              @map("title") @db.VarChar(200)
  description           String?             @db.Text
  urlImage              String              @map("image_url") @db.VarChar(500)
  creeLe                DateTime            @default(now()) @map("created_at")

  profilProfessionnel   ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

model Reservation {
  id                String             @id @default(uuid()) @db.Uuid
  clientId          String             @map("client_id") @db.Uuid
  professionnelId   String             @map("professional_id") @db.Uuid
  serviceId         String             @map("service_id") @db.Uuid
  dateHeure         DateTime           @map("date_time")
  adresseClient     String             @map("client_address") @db.VarChar(255)
  dureeMinutes      Int                @map("duration_minutes") @default(60)
  statut            StatutReservation  @default(EN_ATTENTE)
  notes             String?            @map("notes") @db.Text
  prixConvenu       Decimal?           @map("agreed_price") @db.Decimal(10, 2)
  raisonAnnulation  String?            @map("cancel_reason") @db.Text
  creeLe            DateTime           @default(now()) @map("created_at")
  misAJourLe        DateTime           @default(now()) @map("updated_at")

  client            Utilisateur        @relation("ReservationsClient", fields: [clientId], references: [id])
  professionnel     ProfilProfessionnel @relation(fields: [professionnelId], references: [id])
  service           Service            @relation(fields: [serviceId], references: [id])
  paiement          Paiement?
  conversations     Conversation[]
  communications    CommunicationReservation[]

  @@map("bookings")
}

model CommunicationReservation {
  id                   String              @id @default(uuid()) @db.Uuid
  reservationId        String              @map("booking_id") @db.Uuid
  utilisateurId        String              @map("user_id") @db.Uuid
  canal                CanalCommunication  @map("channel")
  destinataire         String              @map("recipient") @db.VarChar(255)
  sujet                String?             @map("subject") @db.VarChar(255)
  contenu              String              @map("content") @db.Text
  fournisseur          String?             @map("provider") @db.VarChar(100)
  identifiantFournisseur String?           @map("provider_message_id") @db.VarChar(255)
  statut               StatutCommunication @default(EN_ATTENTE) @map("status")
  erreur               String?             @map("error") @db.Text
  metadata             Json?               @map("metadata")
  envoyeLe             DateTime?           @map("sent_at")
  creeLe               DateTime            @default(now()) @map("created_at")
  misAJourLe           DateTime            @updatedAt @map("updated_at")

  reservation          Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  utilisateur          Utilisateur         @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([reservationId, canal])
  @@index([utilisateurId, creeLe])
  @@index([statut, creeLe])
  @@map("reservation_communications")
}

model Paiement {
  id                   String          @id @default(uuid()) @db.Uuid
  reservationId        String          @unique @map("booking_id") @db.Uuid
  clientId             String          @map("client_id") @db.Uuid
  professionalId       String          @map("professional_id") @db.Uuid
  montant              Decimal         @map("amount") @db.Decimal(12, 2)
  montantCommission    Decimal         @map("commission_amount") @db.Decimal(12, 2)
  montantNet           Decimal         @map("net_amount") @db.Decimal(12, 2)
  methode              MethodePaiement @map("method")
  statut               StatutPaiement  @default(EN_ATTENTE)
  escrowStatus         EscrowStatus    @default(LOCKED)
  referenceTransaction String?         @map("transaction_ref") @db.VarChar(200)
  referenceFournisseur String?         @map("provider_ref") @db.VarChar(200)
  gatewayReference     String?         @map("gateway_ref") @db.VarChar(200)
  processedAt          DateTime?       @map("processed_at")
  escrowReleasedAt     DateTime?       @map("escrow_released_at")
  disputedAt           DateTime?       @map("disputed_at")
  raisonRemboursement  String?         @map("refund_reason") @db.Text
  creeLe               DateTime        @default(now()) @map("created_at")
  misAJourLe           DateTime        @updatedAt @map("updated_at")

  reservation          Reservation     @relation(fields: [reservationId], references: [id])
  transactionsPortefeuille TransactionPortefeuille[]

  @@index([statut, escrowStatus])
  @@index([referenceTransaction])
  @@index([referenceFournisseur])
  @@index([gatewayReference])
  @@map("payments")
}

model CleIdempotence {
  id             String            @id @default(uuid()) @db.Uuid
  cle            String            @unique @map("key") @db.VarChar(160)
  portee         String            @map("scope") @db.VarChar(100)
  hashRequete    String            @map("request_hash") @db.VarChar(128)
  statut         StatutIdempotence @default(EN_COURS) @map("status")
  reponse        Json?             @map("response")
  expireLe       DateTime          @map("expires_at")
  creeLe         DateTime          @default(now()) @map("created_at")
  misAJourLe     DateTime          @updatedAt @map("updated_at")

  @@index([portee, expireLe])
  @@index([statut, expireLe])
  @@map("idempotency_keys")
}

model EvenementWebhookPaiement {
  id                    String               @id @default(uuid()) @db.Uuid
  cleEvenement          String               @unique @map("event_key") @db.VarChar(220)
  fournisseur           String               @map("provider") @db.VarChar(80)
  referenceFournisseur  String               @map("provider_ref") @db.VarChar(200)
  statutProvider        String               @map("provider_status") @db.VarChar(80)
  signatureValide       Boolean              @default(false) @map("signature_valid")
  payload               Json                 @map("payload")
  statut                StatutWebhookPaiement @default(RECU) @map("status")
  erreur                String?              @map("error") @db.Text
  recuLe                DateTime             @default(now()) @map("received_at")
  traiteLe              DateTime?            @map("processed_at")

  @@index([referenceFournisseur])
  @@index([statut, recuLe])
  @@map("payment_webhook_events")
}

model TransactionPortefeuille {
  id                    String                     @id @default(uuid()) @db.Uuid
  profilProfessionnelId String                     @map("professional_id") @db.Uuid
  paiementId            String?                    @map("payment_id") @db.Uuid
  type                  TypeTransactionPortefeuille
  montant               Decimal                    @map("amount") @db.Decimal(12, 2)
  soldeApres            Decimal                    @map("balance_after") @db.Decimal(12, 2)
  description           String                     @db.Text
  reference             String                     @unique @db.VarChar(220)
  creeLe                DateTime                   @default(now()) @map("created_at")

  profilProfessionnel   ProfilProfessionnel        @relation(fields: [profilProfessionnelId], references: [id])
  paiement              Paiement?                  @relation(fields: [paiementId], references: [id])

  @@index([profilProfessionnelId, creeLe])
  @@index([paiementId])
  @@map("wallet_transactions")
}

model Conversation {
  id                String         @id @default(uuid()) @db.Uuid
  clientId          String         @map("client_id") @db.Uuid
  prestataireId     String         @map("professional_id") @db.Uuid
  reservationId     String?        @map("booking_id") @db.Uuid
  dernierMessageLe  DateTime?      @map("last_message_at")
  creeLe            DateTime       @default(now()) @map("created_at")

  client            Utilisateur    @relation("ConversationsClient", fields: [clientId], references: [id])
  prestataire       Utilisateur    @relation("ConversationsPrestataire", fields: [prestataireId], references: [id])
  reservation       Reservation?   @relation(fields: [reservationId], references: [id])
  messages          Message[]

  @@unique([clientId, prestataireId])
  @@map("conversations")
}

model Message {
  id                String         @id @default(uuid()) @db.Uuid
  conversationId    String         @map("conversation_id") @db.Uuid
  expediteurId      String         @map("sender_id") @db.Uuid
  contenu           String?        @map("content") @db.Text
  urlMedia          String?        @map("media_url") @db.VarChar(500)
  estLu             Boolean        @default(false) @map("is_read")
  creeLe            DateTime       @default(now()) @map("created_at")

  conversation      Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteur        Utilisateur    @relation("MessagesEnvoyes", fields: [expediteurId], references: [id])

  @@map("messages")
}

model Notification {
  id                String            @id @default(uuid()) @db.Uuid
  utilisateurId     String            @map("user_id") @db.Uuid
  type              TypeNotification
  titre             String            @map("title") @db.VarChar(200)
  corps             String            @map("body") @db.Text
  donnees           Json?             @map("data")
  estLue            Boolean           @default(false) @map("is_read")
  creeLe            DateTime          @default(now()) @map("created_at")

  utilisateur       Utilisateur       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum StatutEvenement {
  EN_ATTENTE
  TRAITE
  ECHEC
}

model EvenementOutbox {
  id              String           @id @default(uuid()) @db.Uuid
  typeEvenement   String           @map("event_type") @db.VarChar(100)
  payload         Json             @map("payload")
  correlationId   String?          @map("correlation_id") @db.Uuid
  statut          StatutEvenement  @default(EN_ATTENTE) @map("status")
  creeLe          DateTime         @default(now()) @map("created_at")
  traiteLe        DateTime?        @map("processed_at") @db.Timestamp
  nbTentatives    Int              @default(0) @map("attempts")
  erreur          String?           @map("error") @db.Text

  @@index([statut, creeLe])
  @@map("outbox_events")
}

enum TypeActionAudit {
  CONNEXION
  DECONNEXION
  CREATION
  MODIFICATION
  SUPPRESSION
  PAIEMENT
  KYC_SOUMISSION
  KYC_APPROBATION
  KYC_REJET
  RESERVATION_CREATION
  RESERVATION_CONFIRMATION
  RESERVATION_ANNULATION
  LITIGE_OUVERTURE
  LITIGE_RESOLUTION
  RETRAIT
}

model JournalAudit {
  id                 String          @id @default(uuid()) @db.Uuid
  utilisateurId      String?         @map("user_id") @db.Uuid
  nomUtilisateur     String?         @map("user_name") @db.VarChar(100)
  typeAction         TypeActionAudit @map("action_type")
  description        String          @map("description") @db.Text
  entiteType         String?         @map("entity_type") @db.VarChar(50)
  entiteId           String?         @map("entity_id") @db.Uuid
  adresseIp          String?         @map("ip_address") @db.VarChar(45)
  userAgent          String?         @map("user_agent") @db.Text
  latitude           Decimal?        @db.Decimal(10, 7)
  longitude          Decimal?        @db.Decimal(10, 7)
  localisationTexte  String?         @map("location_label") @db.VarChar(255)
  creeLe             DateTime        @default(now()) @map("created_at")

  @@index([utilisateurId, creeLe])
  @@index([typeAction, creeLe])
  @@map("audit_logs")
}

model DemandeRetrait {
  id                  String          @id @default(uuid()) @db.Uuid
  profilProfessionnelId String        @map("professional_id") @db.Uuid
  montant             Decimal         @map("amount") @db.Decimal(12, 2)
  methode             MethodePaiement @map("method")
  statut              StatutRetrait   @default(EN_ATTENTE)
  referenceFournisseur String?        @map("provider_ref") @db.VarChar(200)
  demandeLe           DateTime        @default(now()) @map("requested_at")
  traiteLe            DateTime?       @map("processed_at")

  profilProfessionnel ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id])

  @@map("withdrawal_requests")
}
