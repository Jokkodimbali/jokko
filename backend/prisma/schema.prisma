generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis()]
}

enum RoleUtilisateur {
  CLIENT
  PRESTATAIRE
  ADMIN
}

enum StatutKyc {
  EN_ATTENTE
  VERIFIE
  REJETE
}

enum TypePrix {
  FIXE
  NEGOCIABLE
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  PAYEE_SEQUESTRE
  EN_COURS
  TERMINEE
  ANNULEE
  NO_SHOW
  LITIGE
}

enum StatutAjustementPrixReservation {
  AUCUN
  EN_ATTENTE_CLIENT
  ACCEPTE
  REFUSE
}

enum MethodePaiement {
  WAVE
  ORANGE_MONEY
  CARTE
}

enum StatutPaiement {
  EN_ATTENTE
  SUCCES
  ECHEC
  REMBOURSE
}

enum StatutRetrait {
  EN_ATTENTE
  EN_COURS
  TERMINE
  ECHEC
  ANNULE
}

enum StatutIdempotence {
  EN_COURS
  TERMINE
  ECHEC
}

enum StatutWebhookPaiement {
  RECU
  TRAITE
  ECHEC
  IGNORE
}

enum TypeTransactionPortefeuille {
  CREDIT_ESCROW
  DEBIT_RETRAIT
  REMBOURSEMENT
  COMMISSION
  AJUSTEMENT
}

enum EscrowStatus {
  LOCKED
  RELEASED
  DISPUTED
  REFUNDED
}

enum TypeNotification {
  NOUVELLE_RESERVATION
  RESERVATION_CONFIRMEE
  RESERVATION_ANNULEE
  PAIEMENT_CONFIRME
  AJUSTEMENT_PRIX_PROPOSE
  AJUSTEMENT_PRIX_ACCEPTE
  AJUSTEMENT_PRIX_REFUSE
  PRESTATAIRE_EN_ROUTE
  PAIEMENT_LIBERE
  NOUVEAU_MESSAGE
  KYC_APPROUVEE
  KYC_REJETEE
  LITIGE_OUVERT
  LITIGE_RESOLU
  RESERVATION_FINALISEE
  ANNONCE_ADMIN
}

enum StatutPresenceProfessionnel {
  HORS_LIGNE
  EN_LIGNE
  EN_ROUTE
  EN_PRESTATION
}

enum StatutSessionTrackingReservation {
  EN_ROUTE
  TERMINEE
  ANNULEE
}

enum StatutLitige {
  OUVERT
  EN_REVUE
  RESOLU
  REJETE
}

enum PrioriteLitige {
  BASSE
  MOYENNE
  HAUTE
}

enum DecisionResolutionLitige {
  REMBOURSER_CLIENT
  CREDITER_PRESTATAIRE
  PARTAGER
}

enum CanalCommunication {
  EMAIL
  SMS
}

enum StatutCommunication {
  EN_ATTENTE
  ENVOYE
  ECHEC
  CONFIGURATION_MANQUANTE
}

enum StatutNegotiation {
  EN_ATTENTE_PRESTATAIRE
  EN_ATTENTE_CLIENT
  ACCEPTEE
  REFUSEE
  ANNULEE
  CONVERTIE_EN_RESERVATION
}

enum RoleNegociateur {
  CLIENT
  PRESTATAIRE
}

model Utilisateur {
  id                String            @id @default(uuid()) @db.Uuid
  numeroTelephone   String            @unique @map("phone_number") @db.VarChar(20)
  nom               String            @map("name") @db.VarChar(100)
  email             String?           @unique @db.VarChar(150)
  adresse           String?           @map("address") @db.VarChar(255)
  motDePasseHash    String?           @map("password_hash") @db.VarChar(255)
  fournisseurOauth  String?           @map("oauth_provider") @db.VarChar(50)
  identifiantOauth  String?           @map("oauth_id") @db.VarChar(200)
  role              RoleUtilisateur   @default(CLIENT)
  urlAvatar         String?           @map("avatar_url") @db.VarChar(500)
  jetonFcm          String?           @map("fcm_token") @db.VarChar(500)
  estActif          Boolean           @default(true) @map("is_active")
  creeLe            DateTime          @default(now()) @map("created_at")
  misAJourLe        DateTime          @updatedAt @map("updated_at")

  profilProfessionnel       ProfilProfessionnel?
  reservationsClient        Reservation[]          @relation("ReservationsClient")
  conversationsClient       Conversation[]         @relation("ConversationsClient")
  conversationsPrestataire  Conversation[]         @relation("ConversationsPrestataire")
  messagesEnvoyes           Message[]              @relation("MessagesEnvoyes")
  notifications             Notification[]
  communicationsReservation CommunicationReservation[]
  sessionsAuthentification  SessionAuthentification[]
  favorisProfessionnels     FavoriProfessionnel[]
  negotiationsClient        Negotiation[]          @relation("NegotiationsClient")
  paiementsClient           Paiement[]             @relation("PaymentsClient")
  moyensPaiementEnregistres MoyenPaiementEnregistre[]
  litigesSignales           Litige[]               @relation("ReportedDisputes")
  litigesResolus            Litige[]               @relation("ResolvedDisputes")
  sessionsTrackingClient    SessionTrackingReservation[] @relation("TrackingSessionsClient")

  @@map("users")
}

model SessionAuthentification {
  id             String      @id @default(uuid()) @db.Uuid
  utilisateurId  String      @map("user_id") @db.Uuid
  hashJeton      String      @map("token_hash") @db.VarChar(255)
  expireLe       DateTime    @map("expires_at")
  revoqueLe      DateTime?   @map("revoked_at")
  creeLe         DateTime    @default(now()) @map("created_at")
  misAJourLe     DateTime    @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([hashJeton])
  @@index([utilisateurId])
  @@index([expireLe])
  @@map("auth_sessions")
}

model VerificationOtp {
  id                String    @id @default(uuid()) @db.Uuid
  numeroTelephone   String    @unique @map("phone_number") @db.VarChar(20)
  hashCode          String    @map("code_hash") @db.VarChar(255)
  expireLe          DateTime  @map("expires_at")
  tentatives        Int       @default(0) @map("attempts")
  dernierEnvoiLe    DateTime  @map("last_sent_at")
  consommeLe        DateTime? @map("consumed_at")
  creeLe            DateTime  @default(now()) @map("created_at")
  misAJourLe        DateTime  @updatedAt @map("updated_at")

  @@index([expireLe])
  @@map("otp_verifications")
}

model ProfilProfessionnel {
  id                 String       @id @default(uuid()) @db.Uuid
  utilisateurId      String       @unique @map("user_id") @db.Uuid
  biographie         String?      @map("bio") @db.Text
  nomEntreprise      String?      @map("company_name") @db.VarChar(150)
  urlPieceIdentiteRecto   String?      @map("id_card_url_recto") @db.VarChar(500)
  urlPieceIdentiteVerso  String?      @map("id_card_url_verso") @db.VarChar(500)
  statutKyc          StatutKyc    @default(EN_ATTENTE) @map("kyc_status")
  raisonRejetKyc     String?      @map("kyc_reject_reason") @db.Text
  localisation       Unsupported("geography(Point, 4326)")?
  ville              String?      @map("city") @db.VarChar(100)
  noteGlobale        Decimal      @default(0.0) @map("global_rating") @db.Decimal(2, 1)
  nombreAvis         Int          @default(0) @map("total_reviews")
  soldePortefeuille  Decimal      @default(0.00) @map("wallet_balance") @db.Decimal(12, 2)
  creeLe             DateTime     @default(now()) @map("created_at")

  utilisateur      Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  services         Service[]
  disponibilites   Disponibilite[]
  elementsPortfolio ElementPortfolio[]
  reservations     Reservation[]
  negotiations     Negotiation[]                @relation("NegotiationsProfessional")
  demandesRetrait  DemandeRetrait[]
  transactionsPortefeuille TransactionPortefeuille[]
  paiements        Paiement[]                  @relation("PaymentsProfessional")
  presence         PresenceProfessionnel?
  sessionsTracking SessionTrackingReservation[]
  favoris          FavoriProfessionnel[]

  @@map("professional_profiles")
}

model FavoriProfessionnel {
  id                    String   @id @default(uuid()) @db.Uuid
  utilisateurId         String   @map("user_id") @db.Uuid
  profilProfessionnelId String   @map("professional_id") @db.Uuid
  creeLe                DateTime @default(now()) @map("created_at")

  utilisateur           Utilisateur          @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  profilProfessionnel   ProfilProfessionnel  @relation(fields: [profilProfessionnelId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, profilProfessionnelId])
  @@index([utilisateurId, creeLe])
  @@index([profilProfessionnelId])
  @@map("professional_favorites")
}

model Categorie {
  id         String     @id @default(uuid()) @db.Uuid
  nom        String     @map("name") @unique @db.VarChar(100)
  urlIcone   String?    @map("icon_url") @db.VarChar(500)
  ordreTri   Int        @default(0) @map("sort_order") @db.SmallInt
  tauxCommission Decimal @default(10.00) @map("commission_rate") @db.Decimal(5, 2)
  estActive  Boolean    @default(true) @map("is_active")

  services   Service[]

  @@map("categories")
}

model Service {
  id                    String              @id @default(uuid()) @db.Uuid
  profilProfessionnelId String              @map("professional_id") @db.Uuid
  categorieId           String              @map("category_id") @db.Uuid
  nom                   String              @map("name") @db.VarChar(200)
  description           String              @db.Text
  prix                  Decimal             @map("price") @db.Decimal(10, 2)
  typePrix              TypePrix            @map("price_type")
  dureeMinutes          Int                 @default(15) @map("duration_minutes")
  estObligatoire        Boolean             @default(false) @map("is_required")
  estDisponible         Boolean             @default(true) @map("is_available")
  creeLe                DateTime            @default(now()) @map("created_at")
  misAJourLe            DateTime            @updatedAt @map("updated_at")

  profilProfessionnel   ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id], onDelete: Cascade)
  categorie             Categorie           @relation(fields: [categorieId], references: [id])
  reservations          Reservation[]
  negotiations          Negotiation[]

  @@unique([id, profilProfessionnelId])
  @@map("services")
}

model Disponibilite {
  id                    String              @id @default(uuid()) @db.Uuid
  profilProfessionnelId String              @map("professional_id") @db.Uuid
  jourSemaine           Int                 @map("day_of_week") @db.SmallInt
  heureDebut            DateTime            @map("start_time") @db.Time
  heureFin              DateTime            @map("end_time") @db.Time
  estActive             Boolean             @default(true) @map("is_active")

  profilProfessionnel   ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model ElementPortfolio {
  id                    String              @id @default(uuid()) @db.Uuid
  profilProfessionnelId String              @map("professional_id") @db.Uuid
  titre                 String              @map("title") @db.VarChar(200)
  description           String?             @db.Text
  urlImage              String              @map("image_url") @db.VarChar(500)
  creeLe                DateTime            @default(now()) @map("created_at")

  profilProfessionnel   ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

model Reservation {
  id                String             @id @default(uuid()) @db.Uuid
  clientId          String             @map("client_id") @db.Uuid
  professionnelId   String             @map("professional_id") @db.Uuid
  serviceId         String             @map("service_id") @db.Uuid
  dateHeure         DateTime           @map("date_time")
  adresseClient     String             @map("client_address") @db.VarChar(255)
  dureeMinutes      Int                @map("duration_minutes") @default(60)
  statut            StatutReservation  @default(EN_ATTENTE)
  notes             String?            @map("notes") @db.Text
  prixConvenu       Decimal?           @map("agreed_price") @db.Decimal(10, 2)
  statutAjustementPrix StatutAjustementPrixReservation @default(AUCUN) @map("price_adjustment_status")
  prixAjustementPropose Decimal?       @map("proposed_adjusted_price") @db.Decimal(10, 2)
  raisonAjustementPrix String?         @map("price_adjustment_reason") @db.Text
  demandeAjustementPrixLe DateTime?    @map("price_adjustment_requested_at")
  raisonAnnulation  String?            @map("cancel_reason") @db.Text
  clientRating      Int?               @map("client_rating") @db.SmallInt
  clientReview      String?            @map("client_review") @db.Text
  clientReviewedAt  DateTime?          @map("client_reviewed_at")
  creeLe            DateTime           @default(now()) @map("created_at")
  misAJourLe        DateTime           @default(now()) @map("updated_at")

  client            Utilisateur        @relation("ReservationsClient", fields: [clientId], references: [id])
  professionnel     ProfilProfessionnel @relation(fields: [professionnelId], references: [id])
  service           Service            @relation(fields: [serviceId], references: [id])
  paiement          Paiement?
  conversation      Conversation?
  communications    CommunicationReservation[]
  negotiation       Negotiation?
  litige            Litige?
  trackingSession   SessionTrackingReservation?

  @@unique([id, clientId, professionnelId])
  @@index([clientId, dateHeure])
  @@index([professionnelId, dateHeure])
  @@index([serviceId, dateHeure])
  @@index([statut, dateHeure])
  @@index([professionnelId, clientReviewedAt])
  @@map("bookings")
}

model Negotiation {
  id                 String             @id @default(uuid()) @db.Uuid
  clientId           String             @map("client_id") @db.Uuid
  professionnelId    String             @map("professional_id") @db.Uuid
  serviceId          String             @map("service_id") @db.Uuid
  statut             StatutNegotiation  @default(EN_ATTENTE_PRESTATAIRE)
  montantInitial     Decimal            @map("initial_amount") @db.Decimal(10, 2)
  montantCourant     Decimal            @map("current_amount") @db.Decimal(10, 2)
  montantAccepte     Decimal?           @map("accepted_amount") @db.Decimal(10, 2)
  dernierProposePar  RoleNegociateur    @map("last_proposed_by")
  messageCourant     String?            @map("current_message") @db.Text
  raisonCloture      String?            @map("close_reason") @db.Text
  reservationId      String?            @unique @map("booking_id") @db.Uuid
  creeLe             DateTime           @default(now()) @map("created_at")
  misAJourLe         DateTime           @updatedAt @map("updated_at")

  client             Utilisateur        @relation("NegotiationsClient", fields: [clientId], references: [id], onDelete: Cascade)
  professionnel      ProfilProfessionnel @relation("NegotiationsProfessional", fields: [professionnelId], references: [id], onDelete: Cascade)
  service            Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  reservation        Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  propositions       PropositionNegotiation[]

  @@index([clientId, statut, creeLe])
  @@index([professionnelId, statut, creeLe])
  @@index([serviceId, creeLe])
  @@map("negotiations")
}

model PropositionNegotiation {
  id                String            @id @default(uuid()) @db.Uuid
  negotiationId     String            @map("negotiation_id") @db.Uuid
  proposePar        RoleNegociateur   @map("proposed_by")
  montant           Decimal           @db.Decimal(10, 2)
  message           String?           @db.Text
  creeLe            DateTime          @default(now()) @map("created_at")

  negotiation       Negotiation       @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  @@index([negotiationId, creeLe])
  @@map("negotiation_offers")
}

model CommunicationReservation {
  id                   String              @id @default(uuid()) @db.Uuid
  reservationId        String              @map("booking_id") @db.Uuid
  utilisateurId        String              @map("user_id") @db.Uuid
  canal                CanalCommunication  @map("channel")
  destinataire         String              @map("recipient") @db.VarChar(255)
  sujet                String?             @map("subject") @db.VarChar(255)
  contenu              String              @map("content") @db.Text
  fournisseur          String?             @map("provider") @db.VarChar(100)
  identifiantFournisseur String?           @map("provider_message_id") @db.VarChar(255)
  statut               StatutCommunication @default(EN_ATTENTE) @map("status")
  erreur               String?             @map("error") @db.Text
  metadata             Json?               @map("metadata")
  envoyeLe             DateTime?           @map("sent_at")
  creeLe               DateTime            @default(now()) @map("created_at")
  misAJourLe           DateTime            @updatedAt @map("updated_at")

  reservation          Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  utilisateur          Utilisateur         @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([reservationId, canal])
  @@index([utilisateurId, creeLe])
  @@index([statut, creeLe])
  @@map("reservation_communications")
}

model Paiement {
  id                   String          @id @default(uuid()) @db.Uuid
  reservationId        String          @unique @map("booking_id") @db.Uuid
  clientId             String          @map("client_id") @db.Uuid
  professionalId       String          @map("professional_id") @db.Uuid
  montant              Decimal         @map("amount") @db.Decimal(12, 2)
  montantCommission    Decimal         @map("commission_amount") @db.Decimal(12, 2)
  montantNet           Decimal         @map("net_amount") @db.Decimal(12, 2)
  methode              MethodePaiement @map("method")
  statut               StatutPaiement  @default(EN_ATTENTE)
  escrowStatus         EscrowStatus    @default(LOCKED)
  referenceTransaction String?         @map("transaction_ref") @db.VarChar(200)
  referenceFournisseur String?         @map("provider_ref") @db.VarChar(200)
  gatewayReference     String?         @map("gateway_ref") @db.VarChar(200)
  processedAt          DateTime?       @map("processed_at")
  escrowReleasedAt     DateTime?       @map("escrow_released_at")
  disputedAt           DateTime?       @map("disputed_at")
  raisonRemboursement  String?         @map("refund_reason") @db.Text
  creeLe               DateTime        @default(now()) @map("created_at")
  misAJourLe           DateTime        @updatedAt @map("updated_at")

  reservation          Reservation     @relation(fields: [reservationId], references: [id])
  client               Utilisateur     @relation("PaymentsClient", fields: [clientId], references: [id])
  professionnel        ProfilProfessionnel @relation("PaymentsProfessional", fields: [professionalId], references: [id])
  transactionsPortefeuille TransactionPortefeuille[]
  litige               Litige?

  @@index([clientId, creeLe])
  @@index([professionalId, creeLe])
  @@index([statut, escrowStatus])
  @@index([referenceTransaction])
  @@index([referenceFournisseur])
  @@index([gatewayReference])
  @@map("payments")
}

model MoyenPaiementEnregistre {
  id             String   @id @default(uuid()) @db.Uuid
  utilisateurId  String   @map("user_id") @db.Uuid
  type           String   @db.VarChar(20)
  libelle        String?  @map("label") @db.VarChar(80)
  valeurMasquee  String   @map("masked_value") @db.VarChar(80)
  titulaire      String?  @map("holder_name") @db.VarChar(100)
  moisExpiration Int?     @map("expiry_month")
  anneeExpiration Int?    @map("expiry_year")
  estDefaut      Boolean  @default(false) @map("is_default")
  creeLe         DateTime @default(now()) @map("created_at")
  misAJourLe     DateTime @updatedAt @map("updated_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, type])
  @@map("saved_payment_methods")
}

model Litige {
  id                       String                      @id @default(uuid()) @db.Uuid
  reservationId            String                      @unique @map("booking_id") @db.Uuid
  paiementId               String?                     @unique @map("payment_id") @db.Uuid
  reporterUserId           String                      @map("reporter_user_id") @db.Uuid
  resolvedByAdminUserId    String?                     @map("resolved_by_admin_user_id") @db.Uuid
  statut                   StatutLitige                @default(OUVERT) @map("status")
  priorite                 PrioriteLitige              @default(MOYENNE) @map("priority")
  raison                   String                      @db.Text
  notesInternes            String?                     @map("internal_notes") @db.Text
  decisionResolution       DecisionResolutionLitige?   @map("resolution_decision")
  pourcentageRemboursementClient Int?                  @map("client_refund_percentage")
  montantRembourseClient   Decimal?                    @map("client_refund_amount") @db.Decimal(12, 2)
  montantPrestataire       Decimal?                    @map("professional_payout_amount") @db.Decimal(12, 2)
  ouvertLe                 DateTime                    @default(now()) @map("opened_at")
  prisEnChargeLe           DateTime?                   @map("review_started_at")
  resoluLe                 DateTime?                   @map("resolved_at")
  rejeteLe                 DateTime?                   @map("rejected_at")
  creeLe                   DateTime                    @default(now()) @map("created_at")
  misAJourLe               DateTime                    @updatedAt @map("updated_at")

  reservation              Reservation                 @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  paiement                 Paiement?                   @relation(fields: [paiementId], references: [id], onDelete: SetNull)
  reporter                 Utilisateur                 @relation("ReportedDisputes", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedByAdmin          Utilisateur?                @relation("ResolvedDisputes", fields: [resolvedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([statut, priorite, ouvertLe])
  @@index([reporterUserId, ouvertLe])
  @@index([resolvedByAdminUserId, resoluLe])
  @@map("disputes")
}

model PresenceProfessionnel {
  id                         String                       @id @default(uuid()) @db.Uuid
  profilProfessionnelId      String                       @unique @map("professional_id") @db.Uuid
  estEnLigne                 Boolean                      @default(false) @map("is_online")
  statut                     StatutPresenceProfessionnel  @default(HORS_LIGNE) @map("status")
  derniereLatitude           Decimal?                     @map("last_latitude") @db.Decimal(10, 7)
  derniereLongitude          Decimal?                     @map("last_longitude") @db.Decimal(10, 7)
  dernierePrecisionMetres    Decimal?                     @map("last_accuracy_meters") @db.Decimal(8, 2)
  derniereOrientationDegres  Int?                         @map("last_heading_degrees") @db.SmallInt
  derniereVitesseKmh         Decimal?                     @map("last_speed_kmh") @db.Decimal(8, 2)
  dernierLibelleLocalisation String?                      @map("last_location_label") @db.VarChar(255)
  dernierePositionLe         DateTime?                    @map("last_position_at")
  dernierVueLe               DateTime?                    @map("last_seen_at")
  creeLe                     DateTime                     @default(now()) @map("created_at")
  misAJourLe                 DateTime                     @updatedAt @map("updated_at")

  profilProfessionnel ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id], onDelete: Cascade)

  @@index([statut, misAJourLe])
  @@index([estEnLigne, misAJourLe])
  @@map("professional_presence")
}

model SessionTrackingReservation {
  id                         String                           @id @default(uuid()) @db.Uuid
  reservationId              String                           @unique @map("booking_id") @db.Uuid
  clientId                   String                           @map("client_id") @db.Uuid
  professionnelId            String                           @map("professional_id") @db.Uuid
  statut                     StatutSessionTrackingReservation @default(EN_ROUTE) @map("status")
  derniereLatitude           Decimal?                         @map("last_latitude") @db.Decimal(10, 7)
  derniereLongitude          Decimal?                         @map("last_longitude") @db.Decimal(10, 7)
  dernierePrecisionMetres    Decimal?                         @map("last_accuracy_meters") @db.Decimal(8, 2)
  derniereOrientationDegres  Int?                             @map("last_heading_degrees") @db.SmallInt
  derniereVitesseKmh         Decimal?                         @map("last_speed_kmh") @db.Decimal(8, 2)
  dernierLibelleLocalisation String?                          @map("last_location_label") @db.VarChar(255)
  dernierePositionLe         DateTime?                        @map("last_position_at")
  demarreLe                  DateTime                         @default(now()) @map("started_at")
  termineLe                  DateTime?                        @map("ended_at")
  creeLe                     DateTime                         @default(now()) @map("created_at")
  misAJourLe                 DateTime                         @updatedAt @map("updated_at")

  reservation   Reservation          @relation(fields: [reservationId, clientId, professionnelId], references: [id, clientId, professionnelId], onDelete: Cascade)
  client        Utilisateur          @relation("TrackingSessionsClient", fields: [clientId], references: [id], onDelete: Cascade)
  professionnel ProfilProfessionnel  @relation(fields: [professionnelId], references: [id], onDelete: Cascade)
  points        PointTrackingReservation[]

  @@unique([reservationId, clientId, professionnelId])
  @@index([professionnelId, statut, misAJourLe])
  @@index([clientId, misAJourLe])
  @@map("reservation_tracking_sessions")
}

model PointTrackingReservation {
  id                  String                     @id @default(uuid()) @db.Uuid
  sessionTrackingId   String                     @map("tracking_session_id") @db.Uuid
  latitude            Decimal                    @db.Decimal(10, 7)
  longitude           Decimal                    @db.Decimal(10, 7)
  precisionMetres     Decimal?                   @map("accuracy_meters") @db.Decimal(8, 2)
  orientationDegres   Int?                       @map("heading_degrees") @db.SmallInt
  vitesseKmh          Decimal?                   @map("speed_kmh") @db.Decimal(8, 2)
  libelleLocalisation String?                    @map("location_label") @db.VarChar(255)
  enregistreLe        DateTime                   @default(now()) @map("recorded_at")

  sessionTracking SessionTrackingReservation @relation(fields: [sessionTrackingId], references: [id], onDelete: Cascade)

  @@index([sessionTrackingId, enregistreLe])
  @@map("reservation_tracking_points")
}

model CleIdempotence {
  id             String            @id @default(uuid()) @db.Uuid
  cle            String            @unique @map("key") @db.VarChar(160)
  portee         String            @map("scope") @db.VarChar(100)
  hashRequete    String            @map("request_hash") @db.VarChar(128)
  statut         StatutIdempotence @default(EN_COURS) @map("status")
  reponse        Json?             @map("response")
  expireLe       DateTime          @map("expires_at")
  creeLe         DateTime          @default(now()) @map("created_at")
  misAJourLe     DateTime          @updatedAt @map("updated_at")

  @@index([portee, expireLe])
  @@index([statut, expireLe])
  @@map("idempotency_keys")
}

model EvenementWebhookPaiement {
  id                    String               @id @default(uuid()) @db.Uuid
  cleEvenement          String               @unique @map("event_key") @db.VarChar(220)
  fournisseur           String               @map("provider") @db.VarChar(80)
  referenceFournisseur  String               @map("provider_ref") @db.VarChar(200)
  statutProvider        String               @map("provider_status") @db.VarChar(80)
  signatureValide       Boolean              @default(false) @map("signature_valid")
  payload               Json                 @map("payload")
  statut                StatutWebhookPaiement @default(RECU) @map("status")
  erreur                String?              @map("error") @db.Text
  recuLe                DateTime             @default(now()) @map("received_at")
  traiteLe              DateTime?            @map("processed_at")

  @@index([referenceFournisseur])
  @@index([statut, recuLe])
  @@map("payment_webhook_events")
}

model TransactionPortefeuille {
  id                    String                     @id @default(uuid()) @db.Uuid
  profilProfessionnelId String                     @map("professional_id") @db.Uuid
  paiementId            String?                    @map("payment_id") @db.Uuid
  type                  TypeTransactionPortefeuille
  montant               Decimal                    @map("amount") @db.Decimal(12, 2)
  soldeApres            Decimal                    @map("balance_after") @db.Decimal(12, 2)
  description           String                     @db.Text
  reference             String                     @unique @db.VarChar(220)
  creeLe                DateTime                   @default(now()) @map("created_at")

  profilProfessionnel   ProfilProfessionnel        @relation(fields: [profilProfessionnelId], references: [id])
  paiement              Paiement?                  @relation(fields: [paiementId], references: [id])

  @@index([profilProfessionnelId, creeLe])
  @@index([paiementId])
  @@map("wallet_transactions")
}

model Conversation {
  id                String         @id @default(uuid()) @db.Uuid
  clientId          String         @map("client_id") @db.Uuid
  prestataireId     String         @map("professional_id") @db.Uuid
  reservationId     String?        @unique @map("booking_id") @db.Uuid
  dernierMessageLe  DateTime?      @map("last_message_at")
  creeLe            DateTime       @default(now()) @map("created_at")

  client            Utilisateur    @relation("ConversationsClient", fields: [clientId], references: [id])
  prestataire       Utilisateur    @relation("ConversationsPrestataire", fields: [prestataireId], references: [id])
  reservation       Reservation?   @relation(fields: [reservationId], references: [id])
  messages          Message[]

  @@index([clientId, prestataireId])
  @@index([dernierMessageLe])
  @@map("conversations")
}

model Message {
  id                String         @id @default(uuid()) @db.Uuid
  conversationId    String         @map("conversation_id") @db.Uuid
  expediteurId      String         @map("sender_id") @db.Uuid
  contenu           String?        @map("content") @db.Text
  urlMedia          String?        @map("media_url") @db.VarChar(500)
  estLu             Boolean        @default(false) @map("is_read")
  creeLe            DateTime       @default(now()) @map("created_at")

  conversation      Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteur        Utilisateur    @relation("MessagesEnvoyes", fields: [expediteurId], references: [id])

  @@index([conversationId, creeLe])
  @@index([expediteurId, creeLe])
  @@map("messages")
}

model Notification {
  id                String            @id @default(uuid()) @db.Uuid
  utilisateurId     String            @map("user_id") @db.Uuid
  type              TypeNotification
  titre             String            @map("title") @db.VarChar(200)
  corps             String            @map("body") @db.Text
  donnees           Json?             @map("data")
  estLue            Boolean           @default(false) @map("is_read")
  creeLe            DateTime          @default(now()) @map("created_at")

  utilisateur       Utilisateur       @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, creeLe])
  @@index([utilisateurId, estLue, creeLe])
  @@map("notifications")
}

enum StatutEvenement {
  EN_ATTENTE
  TRAITE
  ECHEC
}

model EvenementOutbox {
  id              String           @id @default(uuid()) @db.Uuid
  typeEvenement   String           @map("event_type") @db.VarChar(100)
  payload         Json             @map("payload")
  correlationId   String?          @map("correlation_id") @db.Uuid
  statut          StatutEvenement  @default(EN_ATTENTE) @map("status")
  creeLe          DateTime         @default(now()) @map("created_at")
  traiteLe        DateTime?        @map("processed_at") @db.Timestamp
  nbTentatives    Int              @default(0) @map("attempts")
  erreur          String?           @map("error") @db.Text

  @@index([statut, creeLe])
  @@index([typeEvenement, statut, creeLe])
  @@map("outbox_events")
}

enum TypeActionAudit {
  CONNEXION
  DECONNEXION
  CREATION
  MODIFICATION
  SUPPRESSION
  PAIEMENT
  KYC_SOUMISSION
  KYC_APPROBATION
  KYC_REJET
  RESERVATION_CREATION
  RESERVATION_CONFIRMATION
  RESERVATION_ANNULATION
  LITIGE_OUVERTURE
  LITIGE_RESOLUTION
  RETRAIT
}

model JournalAudit {
  id                 String          @id @default(uuid()) @db.Uuid
  utilisateurId      String?         @map("user_id") @db.Uuid
  nomUtilisateur     String?         @map("user_name") @db.VarChar(100)
  typeAction         TypeActionAudit @map("action_type")
  description        String          @map("description") @db.Text
  entiteType         String?         @map("entity_type") @db.VarChar(50)
  entiteId           String?         @map("entity_id") @db.Uuid
  adresseIp          String?         @map("ip_address") @db.VarChar(45)
  userAgent          String?         @map("user_agent") @db.Text
  latitude           Decimal?        @db.Decimal(10, 7)
  longitude          Decimal?        @db.Decimal(10, 7)
  localisationTexte  String?         @map("location_label") @db.VarChar(255)
  creeLe             DateTime        @default(now()) @map("created_at")

  @@index([utilisateurId, creeLe])
  @@index([typeAction, creeLe])
  @@map("audit_logs")
}

model DemandeRetrait {
  id                  String          @id @default(uuid()) @db.Uuid
  profilProfessionnelId String        @map("professional_id") @db.Uuid
  montant             Decimal         @map("amount") @db.Decimal(12, 2)
  methode             MethodePaiement @map("method")
  statut              StatutRetrait   @default(EN_ATTENTE)
  referenceFournisseur String?        @map("provider_ref") @db.VarChar(200)
  demandeLe           DateTime        @default(now()) @map("requested_at")
  traiteLe            DateTime?       @map("processed_at")

  profilProfessionnel ProfilProfessionnel @relation(fields: [profilProfessionnelId], references: [id])

  @@index([profilProfessionnelId, demandeLe])
  @@index([statut, demandeLe])
  @@map("withdrawal_requests")
}
