{
  "installCommand": "cd frontend_web_angular && npm ci",
  "buildCommand": "cd frontend_web_angular && npm run build -- --configuration production",
  "outputDirectory": "frontend_web_angular/dist/frontend_web_angular/browser",
  "env": {
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
